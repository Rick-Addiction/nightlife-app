# Porta 5434: a 5432 tem um Postgres nativo do Windows e a 5433 tem um tunel SSH.
# sslmode/gssencmode=disable: o relay WSL2 do Docker Desktop derruba a negociacao SSL do psycopg3.
DATABASE_URL=postgresql+psycopg://nightlife:nightlife@localhost:5434/nightlife?sslmode=disable&gssencmode=disable
TEST_DATABASE_URL=postgresql+psycopg://nightlife:nightlife@localhost:5434/nightlife_test?sslmode=disable&gssencmode=disable
